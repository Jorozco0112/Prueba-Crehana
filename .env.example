# Copy this file to `.env` to run the API outside Docker.
DATABASE_URL=postgresql+psycopg://todo:todo@localhost:5432/todo
# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRE_MINUTES=30
